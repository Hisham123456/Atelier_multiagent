# Ne jamais publier la vraie clé dans Git.
OPENAI_API_KEY=
ATELIER_MODEL_ECONOMY=gpt-6-luna
ATELIER_MODEL_ADVANCED=gpt-6.1-sol
ATELIER_MAX_CONCURRENCY=3
ATELIER_MAX_CALLS=64
ATELIER_CALL_TIMEOUT=180
ATELIER_MAX_REPAIRS=2
# Coûts USD / million de tokens : facultatifs, à renseigner selon tes tarifs.
# Sans ces valeurs, l'interface affiche les tokens et « coût non configuré ».
ATELIER_ECONOMY_INPUT_PRICE=
ATELIER_ECONOMY_OUTPUT_PRICE=
ATELIER_ADVANCED_INPUT_PRICE=
ATELIER_ADVANCED_OUTPUT_PRICE=
